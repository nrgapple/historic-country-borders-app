{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "test/**/*",
    "tests/**/*.ts",
    "e2e/**/*",
    "worker/**/*.ts",
    "*.ts"
  ],
  "exclude": ["dist", "build", "node_modules"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "resolveJsonModule": true,
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"],
    "paths": {
      "@repo/*": ["./*"]
    }
  }
}
