{
  "name": "historic-country-borders-app",
  "version": "1.0.0",
  "description": "This is map with a timeline to show what country borders were like in the past",
  "license": "CC-BY-NC-SA-4.0",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 next",
    "sitemap:generate": "node scripts/generate-sitemap.js",
    "sitemap:check": "node scripts/generate-sitemap.js --check",
    "prebuild": "yarn sitemap:generate",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build",
    "data:refresh": "yarn data:refresh:historical && yarn data:refresh:schools",
    "data:refresh:historical": "node scripts/refresh-historical-data.js",
    "data:refresh:schools": "node scripts/refresh-school-districts.js",
    "data:reconcile:context": "node scripts/reconcile-historical-entities.js",
    "data:refresh:context": "node scripts/refresh-historical-context.js",
    "data:validate": "yarn data:validate:historical && yarn data:validate:context && yarn data:validate:schools",
    "data:validate:historical": "node scripts/validate-historical-data.js",
    "data:validate:context": "node scripts/validate-historical-context.js",
    "data:validate:schools": "node scripts/validate-school-districts.js",
    "start": "node scripts/static-server.js",
    "preview": "node scripts/static-server.js",
    "static:validate": "node scripts/validate-static-export.js",
    "cloudflare:check": "wrangler deploy --dry-run --outdir .wrangler/deploy-check",
    "cloudflare:deploy": "wrangler deploy",
    "performance:measure": "node scripts/measure-map-performance.js",
    "smoke:production": "node scripts/smoke-production.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . -f unix --max-warnings=0",
    "type-check": "tsc",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "yarn build && yarn test:e2e:run",
    "test:e2e:run": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "size:check": "node scripts/check-build-size.js",
    "quality": "yarn format:check && yarn lint && yarn type-check && yarn test:coverage && yarn data:validate && yarn sitemap:check && yarn build && yarn static:validate && yarn cloudflare:check && yarn size:check",
    "validate": "yarn quality && yarn test:e2e:run"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^3.4.1",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "mapbox-gl": "^3.8.0",
    "next": "15.5.25",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-ga4": "^2.1.0",
    "react-map-gl": "^7.1.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@turf/area": "^6.3.0",
    "@types/geojson": "^7946.0.8",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^22.0.0",
    "@types/polylabel": "^1.0.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitest/coverage-v8": "^3.1.4",
    "@vitest/ui": "^3.1.4",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.25",
    "jsdom": "^26.1.0",
    "node-mocks-http": "^1.17.2",
    "polylabel": "1.1.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.4",
    "vitest": "^3.1.4",
    "webpack": "^5.97.1",
    "wrangler": "4.128.0"
  },
  "engines": {
    "node": "22.x"
  },
  "resolutions": {
    "strip-ansi-cjs": "npm:strip-ansi@^6.0.1",
    "string-width-cjs": "npm:string-width@^4.2.0"
  }
}
