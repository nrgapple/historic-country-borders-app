{
  "name": "historic-country-borders-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "remaster"
    ],
    "nohoist": [
      "historic-borders-remaster/**",
      "**/remaster/**"
    ]
  },
  "description": "Historic Borders: an interactive atlas of how political borders changed over time, plus a Pennsylvania school-district map.",
  "license": "CC-BY-NC-SA-4.0",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "data:refresh": "yarn data:refresh:historical && yarn data:refresh:fonts && yarn data:refresh:schools",
    "data:refresh:historical": "node scripts/refresh-historical-data.js",
    "data:build:historical-split": "node scripts/build-historical-split.js",
    "data:refresh:schools": "node scripts/refresh-school-districts.js",
    "data:refresh:basemap": "node scripts/refresh-basemap.js",
    "data:measure:basemap": "node scripts/refresh-basemap.js --measure",
    "data:refresh:pa-basemap": "node scripts/refresh-pa-basemap.js",
    "data:measure:pa-basemap": "node scripts/refresh-pa-basemap.js --measure",
    "data:measure:pa-districts": "node scripts/measure-pa-districts.mjs",
    "data:refresh:fonts": "node scripts/build-map-fonts.js",
    "data:refresh:pa-sports": "node scripts/refresh-pa-sports.js",
    "data:reconcile:context": "node scripts/reconcile-historical-entities.js",
    "data:refresh:context": "node scripts/refresh-historical-context.js",
    "data:validate": "yarn data:validate:historical && yarn data:validate:context && yarn data:validate:fonts && yarn data:validate:schools && yarn data:validate:basemap && yarn data:validate:pa-basemap && yarn data:validate:pa-sports",
    "data:validate:historical": "node scripts/validate-historical-data.js",
    "data:validate:context": "node scripts/validate-historical-context.js",
    "data:validate:schools": "node scripts/validate-school-districts.js",
    "data:validate:fonts": "node scripts/validate-map-fonts.js",
    "data:validate:basemap": "node scripts/validate-basemap.js",
    "data:validate:pa-basemap": "node scripts/validate-pa-basemap.js",
    "data:validate:pa-sports": "node scripts/validate-pa-sports.js",
    "basemap:review": "node scripts/review-basemap.js",
    "cloudflare:check": "wrangler deploy --dry-run --outdir .wrangler/deploy-check",
    "cloudflare:deploy": "wrangler deploy",
    "smoke:production": "node scripts/smoke-production.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc",
    "test": "vitest run",
    "remaster:data": "yarn --cwd remaster data",
    "remaster:dev": "yarn --cwd remaster dev",
    "remaster:build": "yarn --cwd remaster build",
    "remaster:preview": "yarn --cwd remaster preview",
    "remaster:type-check": "yarn --cwd remaster type-check",
    "remaster:test": "yarn --cwd remaster test",
    "remaster:test:e2e": "yarn --cwd remaster test:e2e",
    "test:layout": "playwright test -c playwright.layout.config.ts",
    "size:check": "node scripts/check-build-size.js",
    "quality": "yarn checks && yarn remaster:type-check && yarn remaster:test && yarn remaster:build && yarn remaster:dist:validate && yarn cloudflare:check && yarn size:check",
    "validate": "yarn quality && yarn remaster:test:e2e",
    "remaster:dist:validate": "node scripts/validate-remaster-dist.js",
    "checks": "yarn format:check && yarn type-check && yarn test && yarn data:validate"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource/alegreya": "5.3.0",
    "@fontsource/alegreya-sans": "5.3.0",
    "@fontsource/alegreya-sc": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/literata": "5.3.0",
    "@fontsource/noto-sans-canadian-aboriginal": "5.3.0",
    "@fontsource/noto-sans-cherokee": "5.3.0",
    "@fontsource/noto-sans-osage": "5.3.0",
    "@mapbox/tiny-sdf": "2.3.0",
    "@mapbox/vector-tile": "^1.3.1",
    "@playwright/test": "^1.62.1",
    "@turf/area": "^6.3.0",
    "@types/node": "^22.0.0",
    "fontkit": "2.0.4",
    "geojson-vt": "^4.0.2",
    "harfbuzzjs": "1.6.3",
    "martinez-polygon-clipping": "^0.7.4",
    "pbf": "^3.2.1",
    "pmtiles": "4.5.0",
    "polylabel": "1.1.0",
    "prettier": "^3.0.0",
    "sharp": "0.35.5",
    "typescript": "^5.0.4",
    "vite": "6.4.6",
    "vitest": "3.2.7",
    "vt-pbf": "^3.1.3",
    "wawoff2": "2.0.1",
    "wrangler": "4.164.0"
  },
  "engines": {
    "node": "22.x"
  },
  "resolutions": {
    "strip-ansi-cjs": "npm:strip-ansi@^6.0.1",
    "string-width-cjs": "npm:string-width@^4.2.0"
  }
}
