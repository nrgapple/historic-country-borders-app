{
  "name": "historic-country-borders-app",
  "version": "1.0.0",
  "description": "This is map with a timeline to show what country borders were like in the past",
  "license": "CC-BY-NC-SA-4.0",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=8192 next",
    "sitemap:generate": "node scripts/generate-sitemap.js",
    "sitemap:check": "node scripts/generate-sitemap.js --check",
    "prebuild": "yarn sitemap:generate",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 next build",
    "preprocess-districts": "NODE_OPTIONS='--max-old-space-size=8192 --expose-gc' node scripts/preprocess-districts.js",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . -f unix --max-warnings=0",
    "type-check": "tsc",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "yarn build && yarn test:e2e:run",
    "test:e2e:run": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "size:check": "node scripts/check-build-size.js",
    "quality": "yarn format:check && yarn lint && yarn type-check && yarn test:coverage && yarn sitemap:check && yarn build && yarn size:check",
    "validate": "yarn quality && yarn test:e2e:run"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^3.4.1",
    "@react-hook/window-size": "3.0.7",
    "@szhsin/react-menu": "^3.0.1",
    "@turf/area": "^6.3.0",
    "@turf/bbox": "^7.2.0",
    "@vercel/speed-insights": "^1",
    "airtable": "^0.12.2",
    "classnames": "^2.3.2",
    "csstype": "^3.1.3",
    "hex-rgba": "^1.0.2",
    "immer": "^9.0.14",
    "mapbox-gl": "^3.8.0",
    "next": "15.3.8",
    "polylabel": "1.1.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-ga4": "^2.1.0",
    "react-hot-toast": "^2.4.0",
    "react-map-gl": "^7.1.7",
    "react-tooltip": "^4.2.13",
    "react-use": "^17.4.0",
    "redis": "^5.1.1",
    "string-to-color": "2.2.2",
    "swr": "^2.3.3",
    "use-immer": "^0.7.0",
    "wikijs": "^6.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/geojson": "^7946.0.8",
    "@types/hex-rgba": "^1.0.0",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^22.0.0",
    "@types/polylabel": "^1.0.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitest/coverage-v8": "^3.1.4",
    "@vitest/ui": "^3.1.4",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.3.8",
    "jsdom": "^26.1.0",
    "node-mocks-http": "^1.17.2",
    "prettier": "^3.0.0",
    "typescript": "^5.0.4",
    "vitest": "^3.1.4",
    "webpack": "^5.97.1"
  },
  "engines": {
    "node": "22.x"
  },
  "resolutions": {
    "strip-ansi-cjs": "npm:strip-ansi@^6.0.1",
    "string-width-cjs": "npm:string-width@^4.2.0"
  }
}
