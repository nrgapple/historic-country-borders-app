{
  "name": "historic-borders-remaster-spike",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "data": "node scripts/build-data.mjs && node scripts/build-basemap.mjs && node scripts/build-glyphs.mjs",
    "data:formats": "node --expose-gc scripts/measure-formats.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node scripts/serve.mjs dist 4400",
    "measure": "node scripts/measure.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.1.9",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "astro": "7.4.12",
    "maplibre-gl": "6.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "2.0.4",
    "@maplibre/geojson-vt": "7.0.1",
    "@maplibre/vt-pbf": "4.3.3",
    "@playwright/test": "1.65.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "flatgeobuf": "4.6.1",
    "geobuf": "4.0.0",
    "oxc-transform-react": "0.156.0",
    "pbf": "4.0.1",
    "topojson-client": "3.1.0",
    "topojson-server": "3.0.1",
    "typescript": "5.9.3"
  }
