---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../../layouts/Base.astro';
import Atlas from '../../atlas/Atlas';
import manifest from '../../data/years.json';
import { formatYearLong } from '../../atlas/years';

export function getStaticPaths() {
  return manifest.years.map((year) => ({ params: { year: String(year) }, props: { year } }));
}
const { year } = Astro.props as { year: number };
const files = (manifest.files as Record<string, { map: string; labels: string; index: string }>)[year];
// Build-time read of the year's facts: crawlers and no-WebGL visitors get a
// real, readable list of the territories on this map. No request-time compute.
const index = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'public', files.index), 'utf8'));
const names: string[] = [...new Set<string>(index.territories.map((t: [string]) => t[0]))].sort((a, b) => a.localeCompare(b));
const first = formatYearLong(manifest.years[0]);
const last = formatYearLong(manifest.years[manifest.years.length - 1]);
const title = `World borders in ${formatYearLong(year)} · Historic Borders`;
const description = `Interactive map of political borders around ${formatYearLong(year)}: ${names.length} territories as reconstructed by the historical-basemaps project. Move through ${manifest.years.length} snapshots from ${first} to ${last}.`;
---
<Base title={title} description={description} path={`/year/${year}`} preload={[{ href: files.map, as: 'fetch', type: 'application/geo+json' }, { href: files.labels, as: 'fetch', type: 'application/geo+json' }, { href: files.index, as: 'fetch', type: 'application/json' }]}>
  <Atlas client:load initialYear={year} />
  <section class="crawl" id="territories" aria-labelledby="territories-title">
    <h2 id="territories-title">Territories on the {formatYearLong(year)} map</h2>
    <p>Borders are reconstructions from <a href="https://github.com/aourednik/historical-basemaps">historical-basemaps</a> (GPL-3.0). Dates and boundaries are approximate.</p>
    <ul>{names.map((n) => <li>{n}</li>)}</ul>
  </section>
</Base>
