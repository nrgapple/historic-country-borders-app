---
import Base from '../../layouts/Base.astro';
import StyleReview from '../../atlas/StyleReview';
import manifest from '../../data/years.json';

// Style-review harness for the Classic-atlas map style: screenshots and
// per-layer profiling. Only the two benchmark years are generated.
export function getStaticPaths() {
  return [1492, 1914].filter((y) => manifest.years.includes(y)).map((year) => ({ params: { year: String(year) }, props: { year } }));
}
const { year } = Astro.props as { year: number };
---
<Base title={`Style review · ${year}`} description="Classic-atlas map style review harness." path={`/review/${year}`}>
  <StyleReview client:only="react" year={year} />
</Base>
<style is:global>
  .review { position: fixed; inset: 0; background: #f1e9d6; padding: 10px; }
  .review__map { position: absolute; inset: 10px; }
  .review__neatline { position: absolute; inset: 10px; width: calc(100% - 20px); height: calc(100% - 20px); pointer-events: none; z-index: 3; overflow: visible; }
  .review .hb-paper-grain { position: fixed !important; }
  @media (max-width: 699px) { .review { padding: 0; } .review__map, .review__neatline { inset: 0; width: 100%; height: 100%; } }
</style>
