/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/data/historical/*
  Cache-Control: public, max-age=31536000, immutable

/data/context/*
  Cache-Control: public, max-age=31536000, immutable

# Map glyph PBFs live under a content-addressed build directory. Wrangler
# sends .pbf with no Content-Type; this type is also on Cloudflare's
# compression list.
/glyphs/*
  Content-Type: application/x-protobuf
  Cache-Control: public, max-age=31536000, immutable

# Content-hashed WOFF2 files. The CSS and license copies in /fonts/ keep the
# default revalidating cache because their names are stable.
/fonts/files/*
  Cache-Control: public, max-age=31536000, immutable

/data/pa-school-districts.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/api/feedback
  Cache-Control: no-store

# Vector tile trees live under /tiles/<tree>/<build>/ and are immutable: a new
# build gets a new directory (docs/BASEMAP.md). Wrangler sends .pbf with no
# Content-Type and .mvt as application/vnd.mapbox-vector-tile, which Cloudflare
# does not compress; application/x-protobuf is on its compression list.
/tiles/*
  Cache-Control: public, max-age=31536000, immutable

/tiles/*.pbf
  Content-Type: application/x-protobuf

/tiles/*.mvt
  Content-Type: application/x-protobuf

# Basemap relief image, locator-globe land and TileJSON, per build.
/basemap/*
  Cache-Control: public, max-age=31536000, immutable

/basemap/*.webp
  Content-Type: image/webp
