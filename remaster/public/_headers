# Remaster build (dist/). Mirrors the repository's public/_headers for the
# paths this build serves. Not deployed until P4 (plan §9.2).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/data/historical/*
  Cache-Control: public, max-age=31536000, immutable

/data/context/*
  Cache-Control: public, max-age=31536000, immutable

# PA district index (content-hashed). Its tiles, and T8's street basemap,
# are under /tiles/* below (docs/PA_BASEMAP.md).
/data/pa/*
  Cache-Control: public, max-age=31536000, immutable

/api/feedback
  Cache-Control: no-store

# T2 basemap tiles and relief: immutable per build directory (docs/BASEMAP.md).
# Wrangler sends .pbf with no Content-Type; application/x-protobuf is on
# Cloudflare's compression list.
/tiles/*
  Cache-Control: public, max-age=31536000, immutable

/tiles/*.pbf
  Content-Type: application/x-protobuf

/basemap/*
  Cache-Control: public, max-age=31536000, immutable

/basemap/*.webp
  Content-Type: image/webp

# T3 map glyphs and fonts: content-hashed per build (docs/FONTS.md).
/glyphs/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/x-protobuf

/fonts/files/*
  Cache-Control: public, max-age=31536000, immutable
