# Remaster build (dist/). Mirrors the repository's public/_headers for the
# paths this build serves. Not deployed until P4 (plan §9.2).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/data/historical/*
  Cache-Control: public, max-age=31536000, immutable

/data/context/*
  Cache-Control: public, max-age=31536000, immutable

/api/feedback
  Cache-Control: no-store

# T2 basemap tiles and relief: immutable per build directory (docs/BASEMAP.md).
# Wrangler sends .pbf with no Content-Type; application/x-protobuf is on
# Cloudflare's compression list.
/tiles/*
  Cache-Control: public, max-age=31536000, immutable

/tiles/*.pbf
  Content-Type: application/x-protobuf

/basemap/*
  Cache-Control: public, max-age=31536000, immutable

/basemap/*.webp
  Content-Type: image/webp

# Map label glyphs (T3 stand-in path until T3 lands).
/glyphs-standin/*
  Content-Type: application/x-protobuf

/fonts/*
  Cache-Control: public, max-age=604800
